{
    "name":  "english-coach-monorepo",
    "version":  "1.0.0",
    "private":  true,
    "workspaces":  [
                       "apps/backend",
                       "packages/*"
                   ],
    "scripts":  {
                    "dev:backend":  "npm run dev --workspace=apps/backend",
                    "build:backend":  "npm run build --workspace=apps/backend",
                    "test:backend":  "npm test --workspace=apps/backend",
                    "db:migrate":  "npm run prisma:migrate --workspace=apps/backend",
                    "db:generate":  "npm run prisma:generate --workspace=apps/backend",
                    "build":  "npm run build:backend"
                },
    "devDependencies":  {
                            "typescript":  "^5.7.0"
                        },
    "dependencies":  {
                         "@neon/config":  "^1.9.5",
                         "@neon/env":  "^1.6.6"
                     }
}
