# Database (Neon Cloud PostgreSQL)
# DATABASE_URL uses the pooled connection string (-pooler suffix) for serverless queries
DATABASE_URL="postgresql://user:password@ep-xyz-pooler.region.neon.tech/neondb?sslmode=require"
# DATABASE_URL_UNPOOLED uses direct unpooled connection for migrations
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xyz.region.neon.tech/neondb?sslmode=require"

# Authentication & Security
JWT_SECRET="replace-with-at-least-32-random-characters-secret"
PROVIDER_CREDENTIAL_ENCRYPTION_KEY="base64-encoded-32-byte-key"

# AI Provider API Keys (Server-Side Only - Never exposed to mobile)
GEMINI_API_KEY="your-google-gemini-api-key"
OPENROUTER_API_KEY="your-openrouter-api-key"

# App & Environment
NODE_ENV="development"
PORT=3000

# Audio Processing Configuration
AUDIO_UPLOAD_DIR="./uploads/audio"
MAX_AUDIO_SIZE_BYTES=10485760
MAX_AUDIO_DURATION_SEC=60
