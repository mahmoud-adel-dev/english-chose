# Database (Neon Cloud PostgreSQL)
# DATABASE_URL uses the pooled connection string (-pooler suffix) for serverless queries
DATABASE_URL="postgresql://user:password@ep-xyz-pooler.region.neon.tech/neondb?sslmode=require"
# DATABASE_URL_UNPOOLED uses direct unpooled connection for migrations
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xyz.region.neon.tech/neondb?sslmode=require"

# Authentication & Security
# Set a unique cryptographically random value (at least 32 bytes) in production.
JWT_SECRET=""
PROVIDER_CREDENTIAL_ENCRYPTION_KEY=""

# AI Provider API Keys (Server-Side Only - Never exposed to mobile)
GEMINI_API_KEY="your-google-gemini-api-key"
OPENROUTER_API_KEY="your-openrouter-api-key"

# App & Environment
NODE_ENV="development"
PORT=3000
# Comma-separated exact browser origins allowed to call the API.
CORS_ALLOWED_ORIGINS="https://english-chose.vercel.app,http://localhost:3000"
NEXT_PUBLIC_APP_URL="https://english-chose.vercel.app"
# Local-only deterministic AI fixtures. Never enable in production.
ALLOW_MOCK_AI="false"

# Audio Processing Configuration
AUDIO_UPLOAD_DIR="./uploads/audio"
MAX_AUDIO_SIZE_BYTES=10485760
MAX_AUDIO_DURATION_SEC=60

# Optional secure administrator bootstrap (no default/demo credentials are created).
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
# Local-only optional demo learner. Never enable in production.
SEED_DEMO_USERS="false"
SEED_DEMO_USER_EMAIL=""
SEED_DEMO_USER_PASSWORD=""
